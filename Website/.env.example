# No environment variables are required for the Website to run locally,
# except for RESEND_API_KEY which is needed for form submissions.

# Resend API key (required for contact, franchise and supplier forms)
# Get yours at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Email addresses (optional — defaults shown)
# CONTACT_EMAIL=info@omniprise.com.py
# FRANCHISE_EMAIL=franquicias@omniprise.com.py
# SUPPLIER_EMAIL=info@omniprise.com.py   # supplier proposals from /proveedores (falls back to CONTACT_EMAIL)

# Sender email — must use the verified domain in Resend
# Default: noreply@contact.omniprise.com.py (verified domain)
# FROM_EMAIL=noreply@contact.omniprise.com.py

# WhatsApp phone number for ordering CTAs is not an env var:
# it lives in src/lib/company.ts (COMPANY.whatsappPhone, used by whatsappOrderUrl in src/lib/brands.ts)

# Dashboard that receives franchise leads (optional — defaults to the production dashboard)
# DASHBOARD_API_URL=https://dashboard.omniprise.com.py
